# Adresa publică a site-ului (pentru sitemap, robots și previzualizările pe rețele).
# Opțional: fără ea se folosește https://tineret-cupseni.vercel.app.
NEXT_PUBLIC_SITE_URL=https://tineret-cupseni.vercel.app

# Resend — trimite pe e-mail formularele de pe site (https://resend.com/api-keys).
RESEND_API_KEY=re_xxxxxxxxx
# Cine primește formularele (mai multe adrese se separă prin virgulă).
FORMULARE_EMAIL_DESTINATAR=adresa@exemplu.ro
# Expeditorul. Cu onboarding@resend.dev, Resend trimite doar către adresa contului;
# după ce verificați domeniul în Resend, folosiți o adresă de pe domeniul vostru.
FORMULARE_EMAIL_EXPEDITOR="Tineret Cupșeni <onboarding@resend.dev>"
